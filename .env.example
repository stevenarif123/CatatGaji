# ==============================================================================
# CatatGaji - Production & Staging Environment Configuration (.env.example)
# Platform Penggajian & HRIS Multi-Tenant Standar Indonesia
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONFIGURASI SERVER & RUNTIME
# ------------------------------------------------------------------------------
# Port server Fastify Node.js (Default Hostinger / VPS: 3000)
PORT=3000

# Host binding server (Gunakan 0.0.0.0 agar dapat diakses oleh Nginx / Reverse Proxy)
HOST=0.0.0.0

# Mode environment: 'production' untuk server live, 'development' untuk lokal
NODE_ENV=production

# Tingkat logging: 'info' (rekomendasi produksi), 'debug' (saat troubleshooting), 'warn', 'error'
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. KEAMANAN & AUTENTIKASI (JWT)
# ------------------------------------------------------------------------------
# Kunci rahasia untuk menandatangani token JWT (Ganti dengan string acak yang kuat!)
# Contoh generate di terminal: openssl rand -hex 32
JWT_SECRET=ganti_dengan_kunci_rahasia_jwt_yang_sangat_panjang_dan_aman_1234567890

# Masa berlaku token otentikasi login
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# 3. CORS & AKSES DOMAIN
# ------------------------------------------------------------------------------
# Domain frontend yang diizinkan mengakses API (Pisahkan dengan koma jika lebih dari satu)
# Contoh: https://namadomainanda.com,https://www.namadomainanda.com
CORS_ORIGIN=https://namadomainanda.com

# ------------------------------------------------------------------------------
# 4. DATABASE (OPSIONAL / AUTO-EMBEDDED)
# ------------------------------------------------------------------------------
# Jika KOSONG (dikomentari), CatatGaji otomatis menggunakan Embedded PostgreSQL (PGlite)
# yang tersimpan persisten di folder './.pglite_data'. Sangat praktis tanpa perlu setup DB terpisah!
#
# Jika ingin menghubungkan ke database PostgreSQL eksternal (Hostinger Remote DB, Supabase, Neon, AWS RDS):
# DATABASE_URL=postgres://username_db:password_db@localhost:5432/nama_database

# ------------------------------------------------------------------------------
# 5. LOKASI STATIC FRONTEND BUILD (OPSIONAL)
# ------------------------------------------------------------------------------
# Lokasi absolut folder build antarmuka web ('dist') jika tidak terdeteksi otomatis.
# Secara default sistem otomatis mencari di '../web/dist' atau 'apps/web/dist'.
# STATIC_PATH=/home/u123456789/domains/namadomainanda.com/public_html/apps/web/dist
