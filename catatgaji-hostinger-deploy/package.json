{
  "name": "catatgaji",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "apps/api/dist/main.js",
  "description": "Platform Multi-Tenant SaaS Penggajian & HRIS Indonesia",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter @catatgaji/web dev",
    "dev:api": "pnpm --filter @catatgaji/api dev",
    "build": "pnpm -r run build",
    "start": "node apps/api/dist/main.js",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "test:engine": "pnpm --filter @catatgaji/api test -- --grep payroll-engine"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^9.0.0",
    "@fastify/static": "^10.1.3",
    "bcryptjs": "^3.0.0",
    "fastify": "^5.3.0",
    "postgres": "^3.4.9",
    "uuid": "^11.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
