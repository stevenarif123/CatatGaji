# Apache / LiteSpeed Configuration for CatatGaji (Production LiteSpeed Reverse Proxy & SPA Fallback)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Teruskan seluruh request API (/api/...) dan status kesehatan (/health) ke backend Fastify Node.js di Port 3000
  RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]
  RewriteRule ^health$ http://127.0.0.1:3000/health [P,L]

  # 2. Jangan ubah jika URL mengarah ke file atau direktori statis fisik yang benar-benar ada
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 3. SPA Fallback: Arahkan seluruh rute URL UI React (/register, /login, /attendance, /payroll, /employees, dll) ke index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Keamanan: Matikan browsing direktori
Options -Indexes

# Caching & Compression untuk file JS / CSS / Asset Vite
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
